#!/usr/bin/env bash
# sbx: build and run coding-agent sandboxes using rootless Podman.
# Install via symlink: base/ and sandboxes/ are always resolved beside this
# script.
set -euo pipefail

SCRIPT_DIR="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")"
BASE_DOCKERFILE="$SCRIPT_DIR/base/Dockerfile"
SANDBOXES_DIR="$SCRIPT_DIR/sandboxes"

usage() {
  local -a names
  mapfile -t names < <(list_sandboxes)

  cat <<'EOF'
Usage: sbx <command> [options]

Commands:
  run <name> [--empty] [--cpus N] [--memory MIB] [-- AGENT_ARGS...]
                Run an agent in the current directory; build if missing
  update <name|all>
                Rebuild an image, refreshing base images and the agent.
                With "all", rebuild every sandbox.
  list          List supported sandboxes

EOF
  printf 'Sandboxes: %s\n\n' "${names[*]}"
  cat <<'EOF'
Run options:
  --empty       Use a disposable /workspace instead of mounting the current directory
  --cpus N      CPU limit (default 4; overrides sandbox.sh)
  --memory MIB  Memory limit in MiB (default 8192; overrides sandbox.sh)
  --            Pass all following arguments directly to the agent
  -h, --help    Show help (also available after any command)

Examples:
  sbx run pi
  sbx run pi --empty
  sbx run claude -- 'explain this project'
  sbx run cursor -- 'explain this project'
  sbx update claude
  sbx update all

The current directory is mounted read-write at the same path inside the
container, unless --empty selects an anonymous volume at /workspace (removed
on exit). Agent state lives in named Podman volumes or tmpfs. The root
filesystem is read-only; /tmp is ephemeral. Network access is enabled for
model APIs and package downloads. Only Git identity is forwarded from the
host, not your entire environment.
EOF
}

die() {
  printf 'sbx: %s\n' "$*" >&2
  exit 1
}

require_podman() {
  command -v podman >/dev/null 2>&1 || die 'podman is required but was not found in PATH'
}

# ---------------------------------------------------------------------------
# Sandbox definitions
# ---------------------------------------------------------------------------

# Print the names of sandboxes that have a sandboxes/<name>/sandbox.sh file.
list_sandboxes() {
  local config
  for config in "$SANDBOXES_DIR"/*/sandbox.sh; do
    [[ -f "$config" ]] || continue
    basename -- "$(dirname -- "$config")"
  done
}

# Set the sandbox_* globals describing sandbox $1. Optional $2 selects empty
# workspace mode (defaults to false, including for updates). Defaults are set here, then
# sandboxes/<name>/sandbox.sh is sourced to adjust them. Arrays keep values with
# spaces intact and avoid passing user input through eval or the shell.
#
#   sandbox_empty_workspace  whether --empty was used (true/false; input only)
#   sandbox_image        image tag to build and run
#   sandbox_dockerfile   Dockerfile appended to base/Dockerfile; its last stage
#                        is the image
#   sandbox_cpus         CPU limit
#   sandbox_memory_mib   memory limit in MiB
#   sandbox_agent_args   default arguments passed to the agent
#   sandbox_build_opts   additional `podman build` options
#   sandbox_run_opts     additional `podman run` options (env, volumes, mounts,
#                        tmpfs, secrets, etc.)
load_sandbox() {
  local sandbox_name="$1" sandbox_config
  local -a names

  # Restrict names so they can't escape the sandboxes directory. The regex is
  # unquoted on purpose: a quoted right side of =~ matches literally.
  sandbox_config="$SANDBOXES_DIR/$sandbox_name/sandbox.sh"
  if [[ ! "$sandbox_name" =~ ^[a-z0-9][a-z0-9_-]*$ || ! -f "$sandbox_config" ]]; then
    mapfile -t names < <(list_sandboxes)
    die "unknown sandbox '$sandbox_name' (choose: ${names[*]})"
  fi

  # shellcheck disable=SC2034
  sandbox_empty_workspace="${2:-false}"
  sandbox_image="localhost/${sandbox_name}-sandbox:latest"
  sandbox_dockerfile="$SANDBOXES_DIR/$sandbox_name/Dockerfile"
  sandbox_cpus=4
  sandbox_memory_mib=8192
  sandbox_agent_args=()
  sandbox_build_opts=()
  sandbox_run_opts=()

  # shellcheck source=/dev/null
  source "$sandbox_config"
}

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

# Build the loaded sandbox's image. Pass "cached" for a normal build, or
# "refresh" to pull base images and reinstall the agent.
#
# The build context is an EMPTY temporary directory, never the user's project
# or this checkout, so source code and secrets can't reach the builder. The
# base and sandbox Dockerfiles are concatenated and sent on stdin, so the base
# stays an ordinary stage: its layers are shared through the build cache, and
# --pull=always never tries to pull a local-only base image. The build runs in
# a subshell to scope the EXIT trap, so the context is removed even when the
# build fails.
build_image() {
  local build_mode="$1" node_version bun_version dockerfile
  local -a build_args=(--file - --tag "$sandbox_image")

  for dockerfile in "$BASE_DOCKERFILE" "$sandbox_dockerfile"; do
    [[ -r "$dockerfile" ]] || die "cannot read $dockerfile"
  done

  # Match host runtimes when available; otherwise keep the base/Dockerfile
  # defaults.
  if command -v node >/dev/null 2>&1 && node_version="$(node --version 2>/dev/null)" && [[ -n "$node_version" ]]; then
    build_args+=(--build-arg "NODE_VERSION=${node_version#v}")
  fi
  if command -v bun >/dev/null 2>&1 && bun_version="$(bun --version 2>/dev/null)" && [[ -n "$bun_version" ]]; then
    build_args+=(--build-arg "BUN_VERSION=$bun_version")
  fi

  case "$build_mode" in
  cached) ;;
  refresh)
    # CACHE_BUST is declared in the agent install stages, so the shared base
    # stays cacheable while npm or an installer fetches a new agent.
    build_args+=(--pull=always --build-arg "CACHE_BUST=$(date +%s%N)")
    ;;
  *) die "internal error: unknown build mode '$build_mode'" ;;
  esac

  (
    context_dir="$(mktemp -d)"
    trap 'rm -rf -- "$context_dir"' EXIT

    printf 'sbx: building %s\n' "$sandbox_image" >&2
    cat -- "$BASE_DOCKERFILE" "$sandbox_dockerfile" |
      podman build --jobs=4 "${build_args[@]}" "${sandbox_build_opts[@]}" "$context_dir"
  )
}

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------

# Add read-only mounts of host files that are shared with every sandbox, when
# they exist, to sandbox_run_opts.
add_host_mounts() {
  if [[ -f "$HOME/.bunfig.toml" ]]; then
    sandbox_run_opts+=(
      --volume "$HOME/.bunfig.toml:/home/node/.bunfig.toml:ro"
    )
  fi
  if [[ -d "$HOME/.agents/skills" ]]; then
    sandbox_run_opts+=(
      --volume "$HOME/.agents/skills:/home/node/.agents/skills:ro"
    )
  fi
}

# Add the host's global Git name and email to sandbox_run_opts. Only the
# identity is passed in, not ~/.gitconfig, because that file can hold credential
# helpers or include other host files. The project's own .git/config is still
# visible.
add_git_identity_env() {
  local git_name git_email
  command -v git >/dev/null 2>&1 || return 0

  git_name="$(git config --global user.name 2>/dev/null || true)"
  if [[ -n "$git_name" ]]; then
    sandbox_run_opts+=(
      --env "GIT_AUTHOR_NAME=$git_name"
      --env "GIT_COMMITTER_NAME=$git_name"
    )
  fi

  git_email="$(git config --global user.email 2>/dev/null || true)"
  if [[ -n "$git_email" ]]; then
    sandbox_run_opts+=(
      --env "GIT_AUTHOR_EMAIL=$git_email"
      --env "GIT_COMMITTER_EMAIL=$git_email"
    )
  fi
}

# Run the loaded sandbox in the current directory or an empty workspace,
# building its image first if needed. The first argument selects empty mode;
# remaining arguments go to the agent after sandbox_agent_args. This
# replaces the shell process, so Podman returns the agent's exit status.
run_sandbox() {
  local empty_workspace="$1" project_dir
  local -a run_args workspace_args
  shift

  if [[ "$empty_workspace" == true ]]; then
    # Anonymous volumes use disk rather than container RAM. --rm removes the
    # volume on exit; :U makes it writable by the container's node user.
    workspace_args=(--workdir /workspace --volume /workspace)
  else
    project_dir="$(pwd -P)"
    # A colon or comma would make the --volume spec ambiguous. Patterns on the
    # right of == and != stay unquoted so they glob-match.
    [[ "$project_dir" != *:* && "$project_dir" != *,* ]] || die 'project path must not contain a colon or comma'
    # Only mount a directory strictly inside the projects tree, ruling out /.
    # The trailing * is unquoted so it matches any subpath.
    [[ "$project_dir" == /home/grant/Projects/* ]] || die 'refusing to start: current directory is not under /home/grant/Projects'
    workspace_args=(--workdir "$project_dir" --volume "$project_dir:$project_dir")
  fi

  if ! podman image exists "$sandbox_image"; then
    build_image cached
  fi

  # keep-id maps the host user to the image's node user (1000:1000), so files
  # stay owned by the host user even when its UID is not 1000.
  # Never add --privileged or host namespaces, or mount the Podman socket.
  run_args=(
    --rm
    --interactive
    --userns="keep-id:uid=1000,gid=1000"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --read-only
    --read-only-tmpfs=false
    --tmpfs "/tmp:rw,nosuid,nodev,size=512m,mode=1777"
    --pids-limit=2048
    --cpus "$sandbox_cpus"
    --memory "${sandbox_memory_mib}m"
    "${workspace_args[@]}"
    --env "TERM=${TERM:-xterm-256color}"
  )

  # Request a TTY only when stdin and stdout are both terminals. Interactive
  # use keeps colors and key handling, and pipes and CI still work.
  if [[ -t 0 && -t 1 ]]; then
    run_args+=(--tty)
  fi

  # Use the krun microVM runtime when it is installed. It needs its own resource
  # annotations.
  if command -v krun >/dev/null 2>&1; then
    run_args+=(
      --runtime=krun
      --annotation=krun.cpus="$sandbox_cpus"
      --annotation=krun.ram_mib="$sandbox_memory_mib"
    )
  fi

  add_host_mounts
  add_git_identity_env

  exec podman run "${run_args[@]}" "${sandbox_run_opts[@]}" "$sandbox_image" "${sandbox_agent_args[@]}" "$@"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_list() {
  (($# == 0)) || die 'list does not take arguments'
  list_sandboxes
}

# sbx run <name> [--empty] [--cpus N] [--memory MIB] [-- AGENT_ARGS...]
cmd_run() {
  (($# > 0)) || die 'run requires a sandbox name (see sbx --help)'
  local sandbox_name="$1" empty_workspace=false cpus_override="" memory_override=""
  shift
  while (($# > 0)); do
    case "$1" in
    --empty)
      empty_workspace=true
      shift
      ;;
    --cpus)
      (($# > 1)) || die '--cpus requires a number'
      shift
      cpus_override="$1"
      shift
      ;;
    --cpus=*)
      cpus_override="${1#--cpus=}"
      shift
      ;;
    --memory)
      (($# > 1)) || die '--memory requires a size in MiB'
      shift
      memory_override="$1"
      shift
      ;;
    --memory=*)
      memory_override="${1#--memory=}"
      shift
      ;;
    --)
      shift
      break
      ;;
    *) die "unexpected argument '$1' (put agent arguments after --)" ;;
    esac
  done

  require_podman
  load_sandbox "$sandbox_name" "$empty_workspace"
  if [[ -n "$cpus_override" ]]; then
    # Unquoted regex so =~ uses a pattern, not a literal string.
    [[ "$cpus_override" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || die "--cpus must be a positive number (got '$cpus_override')"
    awk -v n="$cpus_override" 'BEGIN { exit !(n > 0) }' || die "--cpus must be a positive number (got '$cpus_override')"
    sandbox_cpus="$cpus_override"
  fi
  if [[ -n "$memory_override" ]]; then
    [[ "$memory_override" =~ ^[0-9]+$ ]] || die "--memory must be a positive integer in MiB (got '$memory_override')"
    ((10#$memory_override > 0)) || die "--memory must be a positive integer in MiB (got '$memory_override')"
    sandbox_memory_mib="$memory_override"
  fi
  run_sandbox "$empty_workspace" "$@"
}

# sbx update <name|all>
cmd_update() {
  (($# == 1)) || die 'update requires exactly one sandbox name or "all" (see sbx --help)'
  require_podman
  update_sandboxes "$1"
}

# Rebuild the image for sandbox $1, or for every sandbox when $1 is "all".
# load_sandbox sets globals, so each sandbox is loaded right before its build.
update_sandboxes() {
  local sandbox_name="$1" name
  local -a names

  if [[ "$sandbox_name" == all ]]; then
    mapfile -t names < <(list_sandboxes)
  else
    names=("$sandbox_name")
  fi

  for name in "${names[@]}"; do
    load_sandbox "$name"
    build_image refresh
  done
}

main() {
  local arg subcommand

  if (($# == 0)); then
    usage >&2
    exit 1
  fi

  # -h or --help anywhere before -- shows help; later ones belong to the agent.
  for arg in "$@"; do
    [[ "$arg" != -- ]] || break
    if [[ "$arg" == -h || "$arg" == --help ]]; then
      usage
      return
    fi
  done

  subcommand="$1"
  shift
  case "$subcommand" in
  list) cmd_list "$@" ;;
  run) cmd_run "$@" ;;
  update) cmd_update "$@" ;;
  *) die "unknown command '$subcommand' (see sbx --help)" ;;
  esac
}

main "$@"
